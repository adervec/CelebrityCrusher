# Copy to .env. Everything here is optional — the app runs without any of it.

# Strava: create an app at https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect Developer Program (needs an approved partner account).
# Without these, use CSV/GPX import on the Connect tab — it needs nothing.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Override only if Garmin moves the endpoints (the partner portal is the source of truth):
# GARMIN_AUTH_URL=https://connect.garmin.com/oauth2Confirm
# GARMIN_TOKEN_URL=https://diauth.garmin.com/di-oauth2-service/oauth/token
# GARMIN_API_BASE=https://apis.garmin.com/wellness-api/rest

PORT=8787
# APP_ORIGIN must match the OAuth callback the providers redirect to.
APP_ORIGIN=http://localhost:8787
# DB_FILE=./data/crusher.db
